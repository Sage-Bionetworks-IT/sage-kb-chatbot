# Slack Agent Router configuration
# Copy to config.yaml and fill in your values.
# Environment variables override any value set here.

rovo_mcp_server_url: https://mcp.atlassian.com/v1/mcp
atlassian_cloud_id: your-cloud-id
atlassian_service_user: your-atlassian-service-account
slack_agent_router_secret_id: slack-agent-router/dev

######### Optional configs #########

# bedrock_agent_id / bedrock_agent_alias_id come from the deployed BedrockAgentStack.
# In ECS they are injected by CDK. For local runs, export them as environment variables:
export BEDROCK_AGENT_ID=your-agent-id
export BEDROCK_AGENT_ALIAS_ID=your-alias-id
#
# Authorization by Slack User Group (handles without the @ prefix).
#
# Fail-closed: by default (nothing configured) the bot DENIES everyone.
# A user is allowed only when:
#   - slack_authorized_usergroups contains "*" (bot open to everyone), OR
#   - the user is a member of one of the listed groups.
#
# slack_authorized_usergroups: only members of these groups may use the
#   bot. May be a YAML list (below) or, via the environment variable, a
#   comma-separated string: SLACK_AUTHORIZED_USERGROUPS=it-team,sec-team
#
# slack_authorized_usergroups:
#   - it-team
#   - sec-team
#
# To open the bot to ALL workspace users, set the single wildcard "*":
#   slack_authorized_usergroups: ["*"]
#   (env var: SLACK_AUTHORIZED_USERGROUPS=*)
# Leave the list empty/omitted to keep access denied by default.
